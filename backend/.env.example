# Copie este arquivo para .env e preencha o que for usar.
# Nada aqui é obrigatório para o app funcionar — sem preencher, os recursos
# correspondentes caem em modo de demonstração (ver CLAUDE.md).

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Voz clonada (ElevenLabs) — crie a voz em elevenlabs.io e cole aqui.
# Sem isso, o app usa a voz padrão do navegador (speechSynthesis).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Envio de e-mail (SendGrid) — para o código de verificação de troca de PIN
# chegar de verdade na caixa de entrada dos pais. Sem isso, o código aparece
# na resposta da API em modo demo (só para desenvolvimento local). Crie a
# chave em app.sendgrid.com/settings/api_keys; SENDGRID_FROM precisa ser um
# remetente verificado na SendGrid (Single Sender Verification ou domínio
# autenticado) — https://app.sendgrid.com/settings/sender_auth.
SENDGRID_API_KEY=
SENDGRID_FROM=

# Login dos responsáveis (Fase 1) — assina o cookie de sessão. OBRIGATÓRIO
# em produção (o servidor recusa subir sem isso se NODE_ENV=production);
# em dev, cai num valor fixo se deixar em branco. Gere um valor aleatório
# longo, por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=

# Assinatura mensal via InfinitePay Checkout Integrado (Fase 2). Sem
# INFINITEPAY_HANDLE, o botão "Assinar agora" cai em modo "não
# configurado" — o resto do app funciona normalmente.
# INFINITEPAY_HANDLE é a sua InfiniteTag (o nome de usuário do seu App
# InfinitePay), SEM o "$" na frente.
INFINITEPAY_HANDLE=

# URL pública do backend (ex: https://teajudo-backend.onrender.com) —
# necessária SÓ pra InfinitePay conseguir chamar de volta o webhook de
# confirmação de pagamento (POST /api/subscription/webhook). Em
# localhost isso não é alcançável de fora, então em dev pode deixar em
# branco: o link de pagamento ainda é gerado normalmente, só a
# confirmação automática do pagamento não chega (dá pra conferir via
# GET /api/subscription/status quando o webhook rodar em produção).
BACKEND_PUBLIC_URL=
