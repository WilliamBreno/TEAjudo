# Copie este arquivo para .env e preencha o que for usar.
# Nada aqui é obrigatório para o app funcionar — sem preencher, os recursos
# correspondentes caem em modo de demonstração (ver CLAUDE.md).

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Voz clonada (ElevenLabs) — crie a voz em elevenlabs.io e cole aqui.
# Sem isso, o app usa a voz padrão do navegador (speechSynthesis).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Envio de e-mail (SMTP) — para o código de verificação de troca de PIN
# chegar de verdade na caixa de entrada dos pais. Sem isso, o código
# aparece na resposta da API em modo demo (só para desenvolvimento local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
